# Permanent Google Drive storage root.
# Copy .env.example to .env and put your own Drive folder ID here locally.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_tokisclone_folder_id

# Local development: token generated by authorize_drive.py.
GOOGLE_DRIVE_TOKEN_FILE=token.json

# Deployment-only alternative: store the full token.json contents as a secret.
# Never commit this value.
# GOOGLE_DRIVE_TOKEN_JSON={"token":"...","refresh_token":"..."}

# Personal Drive queue worker.
TOKISCLONE_POLL_SECONDS=15

# Tokisclone product rules are not configurable:
# - source policy is always clean-only
# - one profile URL always means all public videos the extractor can enumerate

# Optional: your own exported cookies.txt if TikTok requires your normal logged-in session.
# Keep this file local; .gitignore excludes it.
# TOKISCLONE_COOKIE_FILE=cookies.txt

# Optional transcription settings. Requires faster-whisper.
TOKISCLONE_WHISPER_MODEL=small

# Temporary processing directory used by the MCP-server variant only.
VIDEO_DOWNLOAD_DIR=/tmp/tokisclone

# HTTP MCP server binding. The Drive-queue local worker does not need these.
HOST=0.0.0.0
PORT=8000

# REQUIRED for a real deployed MCP hostname. Comma-separated exact Host header values.
# Example: MCP_ALLOWED_HOSTS=tokisclone.example.com,tokisclone.example.com:*
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

# Browser origins only. Non-browser MCP clients usually send no Origin header.
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
