# Permanent Google Drive storage root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_tokisclone_folder_id

# Local development: token generated by authorize_drive.py.
GOOGLE_DRIVE_TOKEN_FILE=token.json

# Deployment: prefer storing the full token.json contents as a secret instead.
# GOOGLE_DRIVE_TOKEN_JSON={"token":"...","refresh_token":"..."}

# Temporary processing directory only. Files are deleted after Drive upload.
VIDEO_DOWNLOAD_DIR=/tmp/tokisclone

# HTTP server binding.
HOST=0.0.0.0
PORT=8000

# REQUIRED for a real deployed hostname. Comma-separated exact Host header values.
# Example: MCP_ALLOWED_HOSTS=tokisclone.example.com,tokisclone.example.com:*
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

# Browser origins only. Non-browser MCP clients usually send no Origin header.
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
